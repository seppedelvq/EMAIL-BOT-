# Copy to .env.local. Never commit credentials. Node 24 LTS required.
ASSISTANT_MODE=demo
ASSISTANT_ORIGIN=http://localhost:4000
ASSISTANT_DATA_DIR=.assistant-data
ASSISTANT_SCHEDULER=1
# Live setup only: generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASSISTANT_MASTER_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register exactly http://localhost:4000/api/oauth/gmail in Google Cloud.
# Optional local AI. Install Ollama and pull the model separately.
ASSISTANT_AI_PROVIDER=ollama
ASSISTANT_AI_MODEL=llama3.1
ASSISTANT_AI_URL=http://localhost:11434
# Optional cloud AI: set provider=openai, URL=https://api.openai.com/v1, model and key.
ASSISTANT_AI_KEY=
ENABLE_LEGACY_PLAYGROUND=0
NEXT_TELEMETRY_DISABLED=1
